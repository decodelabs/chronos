{
    "name": "decodelabs/destiny",
    "description": "Powerful schedule management system",
    "type": "library",
    "keywords": [],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        }
    ],
    "require": {
        "php": "^8.4",

        "decodelabs/atlas": "^0.14.1",
        "decodelabs/coercion": "^0.3.5",
        "decodelabs/dictum": "^0.7",
        "decodelabs/enumerable": "^0.2.8",
        "decodelabs/exceptional": "^0.6.3",
        "decodelabs/kingdom": "^0.2",
        "decodelabs/nuance": "^0.2",
        "decodelabs/slingshot": "^0.3",

        "nesbot/carbon": "^3",
        "opis/json-schema": "^2.4.1"
    },
    "require-dev": {
        "decodelabs/chorus": "^0.1",
        "decodelabs/phpstan-decodelabs": "^0.7"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Destiny\\": "src/Destiny/"
        },
        "classmap": [
            "src/Destiny.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.1.x-dev"
        },
        "effigy": {
            "exports": [
                "schema"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
